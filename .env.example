# Supabase settings for frontend + Edge Function calls.
# Use either VITE_SUPABASE_URL or VITE_SUPABASE_PROJECT_ID.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# Supabase public anon key (Project Settings -> API -> anon public).
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional modern publishable key (used if anon key is not set).
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Deployed Edge Function name (folder under supabase/functions).
VITE_SUPABASE_FUNCTION_NAME=server

# Optional. Keep empty for routes like /paste and /health.
# Set to make-server-491033a6 only if you intentionally keep legacy prefixed routes.
VITE_SUPABASE_FUNCTION_ROUTE_PREFIX=

# Optional full backend override (e.g. local proxy/emulator).
# Example: http://127.0.0.1:54321/functions/v1/server
# VITE_SERVER_URL=

# Netlify production proxy (recommended to avoid browser CORS preflight issues).
# Set to true when deploying on Netlify custom domains.
VITE_USE_NETLIFY_PROXY=false
VITE_NETLIFY_PROXY_URL=/.netlify/functions/supabase-proxy

# Server-side Netlify function env (set in Netlify dashboard, not in browser env):
# SUPABASE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/make-server-491033a6
# SUPABASE_ANON_KEY=your-anon-public-key
